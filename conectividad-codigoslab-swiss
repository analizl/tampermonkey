// ==UserScript==
// @name         Conectividad Códigos Laboratorio - SWISS MEDICAL
// @namespace    http://tampermonkey.net/
// @version      3.0
// @description  Carga automática códigos Laboratorio Swiss Medical desde Diagnosis
// @author       Diagnosis
// @match        https://*.swissmedical.com.ar/*
// @grant        GM_xmlhttpRequest
// @connect      srapp.diagnosis.com.ar
// @connect      localhost
// @run-at       document-end
// ==/UserScript==

(function() {
    'use strict';

    const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

    function formatearCodigoPrestacion(codigoCrudo) {
        let limpio = String(codigoCrudo).trim();
        if (limpio.length === 6) {
            return limpio;
        }
        return '66' + limpio.padStart(4, '0');
    }

    let nombrePacienteActual = "";
    let idAfiliadoActual = "";

    async function escribirEnInputReact(inputElement, valor) {
        inputElement.focus();

        const setter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;
        setter.call(inputElement, '');
        inputElement.dispatchEvent(new Event('input', { bubbles: true }));
        await sleep(400);

        for (let i = 0; i < valor.length; i++) {
            const char = valor[i];
            const valorAcumulado = valor.substring(0, i + 1);
            setter.call(inputElement, valorAcumulado);

            inputElement.dispatchEvent(new KeyboardEvent('keydown', { bubbles: true, key: char }));
            inputElement.dispatchEvent(new Event('input', { bubbles: true }));
            inputElement.dispatchEvent(new KeyboardEvent('keypress', { bubbles: true, key: char }));
            inputElement.dispatchEvent(new KeyboardEvent('keyup', { bubbles: true, key: char }));

            await sleep(50);
        }

        inputElement.dispatchEvent(new Event('change', { bubbles: true }));
        await sleep(400);
    }

    function mostrarModalErrores(codigosFallidos) {
        const modalViejo = document.getElementById('tm-modal-error-container');
        if (modalViejo) modalViejo.remove();

        // Contenedor principal
        const contenedor = document.createElement('div');
        contenedor.id = 'tm-modal-error-container';
        contenedor.style.position = 'fixed';
        contenedor.style.top = '0';
        contenedor.style.left = '0';
        contenedor.style.width = '100vw';
        contenedor.style.height = '100vh';
        contenedor.style.backgroundColor = 'rgba(0, 0, 0, 0.5)';
        contenedor.style.display = 'flex';
        contenedor.style.justifyContent = 'center';
        contenedor.style.alignItems = 'center';
        contenedor.style.zIndex = '99999';
        contenedor.style.fontFamily = 'Roboto, "Helvetica Neue", sans-serif';

        // Caja del Modal
        const modal = document.createElement('div');
        modal.style.backgroundColor = '#ffffff';
        modal.style.width = '480px';
        modal.style.maxWidth = '90%';
        modal.style.borderRadius = '12px';
        modal.style.boxShadow = '0px 8px 24px rgba(0,0,0,0.3)';
        modal.style.overflow = 'hidden';

        // Encabezado
        const header = document.createElement('div');
        const todoOk = codigosFallidos.length === 0
        header.style.backgroundColor = todoOk ? '#28a745' : '#dc3545';
        header.style.color = 'white';
        header.style.padding = '16px 20px';
        header.style.fontWeight = 'bold';
        header.style.fontSize = '18px';
        header.innerText = todoOk ? '¡Proceso Exitoso! 🎉' : '⚠️ Códigos no cargados';

        // Cuerpo del modal
        const body = document.createElement('div');
        body.style.padding = '20px';
        body.style.color = '#333333';
        body.style.fontSize = '14px';
        body.style.lineHeight = '1.5';

        if (todoOk) {
            body.innerHTML = '<p style="margin:0; font-size: 15px; text-align:center;">Se procesaron y cargaron todas las prestaciones con éxito en Swiss Medical.</p>';
        } else {
            body.innerHTML = '<p style="margin:0 0 12px 0; font-weight: 500;">Las siguientes prestaciones no se pudieron auto-completar automáticamente:</p>';

            // Lista de códigos
            const ul = document.createElement('ul');
            ul.style.margin = '0 0 20px 0';
            ul.style.paddingLeft = '20px';
            ul.style.maxHeight = '180px';
            ul.style.overflowY = 'auto';
            ul.style.border = '1px solid #eeeeee';
            ul.style.paddingTop = '8px';
            ul.style.paddingBottom = '8px';
            ul.style.borderRadius = '6px';
            ul.style.backgroundColor = '#f9f9f9';

            codigosFallidos.forEach(err => {
                const li = document.createElement('li');
                li.style.marginBottom = '6px';
                li.style.color = '#555555';
                li.innerHTML = `<strong>${err}</strong>`;
                ul.appendChild(li);
            });
            body.appendChild(ul);

            // Botón de Copiar al Portapapeles
            const btnCopiar = document.createElement('button');
            btnCopiar.type = 'button';
            btnCopiar.innerText = '📋 Copiar códigos fallidos';
            btnCopiar.style.width = '100%';
            btnCopiar.style.marginBottom = '10px';
            btnCopiar.style.padding = '10px';
            btnCopiar.style.backgroundColor = '#6c757d';
            btnCopiar.style.color = 'white';
            btnCopiar.style.border = 'none';
            btnCopiar.style.borderRadius = '6px';
            btnCopiar.style.cursor = 'pointer';
            btnCopiar.style.fontWeight = '500';

            btnCopiar.addEventListener('click', () => {
                const textoACopiar = codigosFallidos.join('\n');
                const campoTemporal = document.createElement('textarea');
                campoTemporal.value = textoACopiar;
                campoTemporal.style.position = 'fixed';
                campoTemporal.style.opacity = '0';
                document.body.appendChild(campoTemporal);
                campoTemporal.focus();
                campoTemporal.select();

                try {
                    const exito = document.execCommand('copy');
                    if (exito) {
                        btnCopiar.innerText = '✅ ¡Copiado!';
                        btnCopiar.style.backgroundColor = '#28a745';
                    } else {
                        btnCopiar.innerText = '❌ Error al copiar';
                    }
                } catch (err) {
                    console.error(err);
                }

                document.body.removeChild(campoTemporal);
                setTimeout(() => {
                    btnCopiar.innerText = '📋 Copiar códigos fallidos';
                    btnCopiar.style.backgroundColor = '#6c757d';
                }, 2000);
            });
            body.appendChild(btnCopiar);
        }

        // Botón Cerrar
        const btnCerrar = document.createElement('button');
        btnCerrar.type = 'button';
        btnCerrar.innerText = 'Entendido';
        btnCerrar.style.width = '100%';
        btnCerrar.style.padding = '10px';
        btnCerrar.style.backgroundColor = '#007bff';
        btnCerrar.style.color = 'white';
        btnCerrar.style.border = 'none';
        btnCerrar.style.borderRadius = '6px';
        btnCerrar.style.cursor = 'pointer';
        btnCerrar.style.fontWeight = 'bold';

        btnCerrar.addEventListener('click', async () => {
            document.body.removeChild(contenedor);
        });

        body.appendChild(btnCerrar);
        modal.appendChild(header);
        modal.appendChild(body);
        contenedor.appendChild(modal);
        document.body.appendChild(contenedor);
    }

    // CICLO PRINCIPAL DE CARGA
    async function cargarCodigosEnFormulario(listaCodigos) {
        console.log("[Tampermonkey] Iniciando carga de prestaciones...");

        let prestacionFallidas = [];

        for (let i = 0; i < listaCodigos.length; i++) {
            const item = listaCodigos[i];
            const codigoFinal = formatearCodigoPrestacion(item.codigo);
            const cantidadFinal = item.repeticiones || 1;

            try {
                // Buscamos los inputs por id directo o name
                const inputCodigo = document.getElementById('prestacionCodigoConectividad') || document.querySelector('input[name="prestacionCodigo"]');
                const inputCantidad = document.getElementById('prestacionCantidad') || document.querySelector('input[name="prestacionCantidad"]');

                if (!inputCodigo || !inputCantidad) {
                    throw new Error("No se localizaron los inputs de prestación en el DOM.");
                }

                // 1. Limpieza y foco inicial
                inputCodigo.focus();
                await escribirEnInputReact(inputCodigo, '');
                await sleep(150);

                // 2. Escribir el código en el input
                await escribirEnInputReact(inputCodigo, codigoFinal);
                await sleep(300);

                // 3. Forzar apertura del menú desplegable ARIA / Autocomplete
                inputCodigo.dispatchEvent(new Event('focus', { bubbles: true }));
                inputCodigo.dispatchEvent(new KeyboardEvent('keydown', { bubbles: true, key: 'ArrowDown', keyCode: 40 }));
                await sleep(300);

                // 4. Búsqueda de la opción flotante (soporta role="option", li, o divs flotantes)
                let opcionDesplegable = null;
                for (let intento = 0; intento < 25; intento++) {
                    const opcionesAria = Array.from(document.querySelectorAll('[role="option"], [role="listbox"] *, #prestacionCodigo-listbox *'));

                    opcionDesplegable = opcionesAria.find(el => el.textContent.trim().includes(codigoFinal));

                    // Respaldo: búsqueda general en elementos flotantes visibles
                    if (!opcionDesplegable) {
                        const divsVisibles = Array.from(document.querySelectorAll('li, div'))
                            .filter(el => el.offsetParent !== null); // Solo visibles en pantalla
                        opcionDesplegable = divsVisibles.find(el => el.textContent.trim().startsWith(codigoFinal));
                    }

                    if (opcionDesplegable) break;
                    await sleep(150);
                }

                if (opcionDesplegable) {
                    console.log(`[Tampermonkey] Seleccionando opción para: ${codigoFinal}`);
                    opcionDesplegable.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true }));
                    opcionDesplegable.click();
                    opcionDesplegable.dispatchEvent(new MouseEvent('mouseup', { bubbles: true, cancelable: true }));
                    await sleep(400);
                } else {
                    throw new Error("El menú desplegable de Swiss Medical no apareció a tiempo.");
                }

                // 5. Validar si la descripción se completó automáticamente
                const inputDesc = document.getElementById('prestacionDescripcion') || document.querySelector('input[name="prestacionDescripcion"]');
                if (inputDesc && (!inputDesc.value || inputDesc.value.trim() === "")) {
                     throw new Error("Código inexistente (Descripción vacía).");
                }

                // 6. Cargar la Cantidad de forma nativa en React
                inputCantidad.focus();
                await escribirEnInputReact(inputCantidad, String(cantidadFinal));
                await sleep(300);

                // 7. Click en el botón de agregar '+'
                const botonAgregar = document.querySelector('button[aria-label="Agregar prestación"]') ||
                                     Array.from(document.querySelectorAll('button')).find(btn => btn.textContent.trim() === '+');

                if (botonAgregar) {
                    botonAgregar.click();
                    await sleep(1200);
                } else {
                    throw new Error("No se encontró el botón '+' para añadir a la lista.");
                }

            } catch (error) {
                console.error(`[Tampermonkey] ❌ Error con código ${codigoFinal}:`, error.message);
                prestacionFallidas.push(`${codigoFinal} (${item.nombre || 'Sin nombre'} - ${error.message})`);

                // Intentar limpiar el input en caso de fallo para la siguiente iteración
                try {
                    const inputCodigo = document.getElementById('prestacionCodigoConectividad') || document.querySelector('input[name="prestacionCodigo"]');
                    if (inputCodigo) {
                        await escribirEnInputReact(inputCodigo, '');
                    }
                } catch(e){}
                await sleep(500);
            }
        }

        mostrarModalErrores(prestacionFallidas);
    }

    function queryDiagnosis(numeroAfiliado, apellidoAfiliado) {
        //const urlApi = `http://localhost:8001/api/v2/laboratorio/paciente/${numeroAfiliado}/codigos?obra=138&apellido=${apellidoAfiliado}`;
        const urlApi = `https://srapp.diagnosis.com.ar/api/v2/laboratorio/paciente/${numeroAfiliado}/codigos?obra=138&apellido=${apellidoAfiliado}`;
        GM_xmlhttpRequest({
            method: "GET",
            url: urlApi,
            headers: { "Content-Type": "application/json" },
            onload: function(response) {
                if (response.status === 200) {
                    try {
                        const jsonRespuesta = JSON.parse(response.responseText);
                        if (jsonRespuesta && jsonRespuesta.resultCodigos && jsonRespuesta.resultCodigos.length > 0) {
                            console.log("respuesta", jsonRespuesta.resultCodigos)
                            cargarCodigosEnFormulario(jsonRespuesta.resultCodigos);
                        } else {
                            alert("No se encontraron códigos pendientes para este afiliado.");
                        }
                    } catch (e) {
                        console.error("[Tampermonkey] Error JSON:", e);
                    }
                } else {
                    try {
                        const jsonError = JSON.parse(response.responseText);

                        if (jsonError && jsonError.error) {
                            alert("Error: " + jsonError.error);
                        } else {
                            alert("Verifique que tiene la sesión del DWEB iniciada \nError del servidor: " + response.status);
                        }
                    } catch (e) {
                        alert("Error " + response.status + ": " + response.statusText);
                    }
                }
            },
            onerror: function() {
                alert("Error de red con el servidor de Diagnosis.");
            }
        });
    }

    function dibujarBotonCarga(nodoReferencia, nroAfiliado) {
        const botonExistente = document.querySelector('.mi-boton-alerta-swiss');

        if (botonExistente) {
            if (botonExistente.getAttribute('data-afiliado') === nroAfiliado) return;
            botonExistente.remove();
        }

        const spans = document.querySelectorAll('span');
        const etiquetaNombre = Array.from(spans).find(el => el.textContent.trim() === 'Nombre y apellido:');

        let nombreDetectado = '';

        if (etiquetaNombre) {
            const spanValor = etiquetaNombre.nextElementSibling;
            if (spanValor && spanValor.textContent.trim() !== "") {
                nombreDetectado = spanValor.textContent.trim();
            }
        }

        const apellidoAfiliado = nombreDetectado.split(',')[0];

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.innerText = `Cargar Datos y Códigos de Afiliado: ${nombreDetectado} ⏩`;
        btn.className = 'mi-boton-alerta-swiss';
        btn.setAttribute('data-afiliado', nroAfiliado);

        btn.style.marginTop = '0px';
        btn.style.marginBottom = '25px';
        btn.style.padding = '12px 24px';
        btn.style.backgroundColor = '#e4002b';
        btn.style.color = 'white';
        btn.style.border = 'none';
        btn.style.borderRadius = '6px';
        btn.style.cursor = 'pointer';
        btn.style.fontWeight = 'bold';
        btn.style.fontSize = '14px';
        btn.style.boxShadow = '0px 4px 6px rgba(0,0,0,0.15)';
        btn.style.display = 'block';
        btn.style.transition = 'background-color 0.2s';

        btn.addEventListener('mouseenter', () => btn.style.backgroundColor = '#b30021');
        btn.addEventListener('mouseleave', () => btn.style.backgroundColor = '#e4002b');

        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            queryDiagnosis(nroAfiliado, apellidoAfiliado);
        });

        nodoReferencia.after(btn);
    }

    function obtenerNumeroAfiliado() {
        const inputContrato = document.querySelector('input[aria-label="Contrato"]');
        const inputIntegrante = document.querySelector('input[aria-label="Integrante"]');
        const inputValidador = document.querySelector('input[aria-label="Validador"]');

        if (inputContrato && inputContrato.value) {
            const contenedorPadre = inputContrato.closest('div.inline-flex');
            const prefijoElement = contenedorPadre ? contenedorPadre.querySelector('strong') : null;
            const prefijo = prefijoElement ? prefijoElement.textContent.trim() : "800006";

            const contrato = inputContrato.value.trim();
            const integrante = inputIntegrante ? inputIntegrante.value.trim() : "";
            const validador = inputValidador ? inputValidador.value.trim() : "";

            return `${prefijo}${contrato}${integrante}${validador}`.replace(/\s+/g, '');
        }

        const inputLegacy = document.querySelector('input[data-test-id="validate-member-input"]');
        if (inputLegacy && inputLegacy.value) {
            return inputLegacy.value.replace(/\s+/g, '');
        }

        return null;
    }

    setInterval(() => {
        const divs = document.querySelectorAll('div');
        const paso3Activo = Array.from(divs).find(el => {
            const texto = el.textContent.trim().toLowerCase();
            const esPaso3 = texto === 'paso 3';

            const tieneClaseActiva = el.classList.contains('bg-legacy-danger') ||
                                     el.className.includes('bg-legacy-danger');

            return esPaso3 && tieneClaseActiva;
        });

        if (!paso3Activo) {
            const botonExistente = document.querySelector('.mi-boton-alerta-swiss');
            if (botonExistente) botonExistente.remove();
            return;
        }

        const nroAfiliado = obtenerNumeroAfiliado();

        const headers = document.querySelectorAll('h1, h2, h3, h4, strong, div');
        const h2Prestaciones = Array.from(headers).find(el => {
            const txt = el.textContent.trim().toLowerCase();
            return txt === 'prestaciones médicas' || txt === 'prestaciones';
        });

        if (nroAfiliado && h2Prestaciones) {
            dibujarBotonCarga(h2Prestaciones, nroAfiliado);
        }
    }, 1000);
})();
